# ---------------- QUANT PILOT configuration ----------------
# Data source: delta (live Delta Exchange data) | demo (synthetic market) | mt5 (MetaTrader 5)
DATA_SOURCE=delta
DEMO_MODE=false

# ---------------- Delta Exchange (Live Crypto & Gold Data) ----------------
# India: https://api.india.delta.exchange | Global: https://api.delta.exchange
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_SYMBOL_BTC=BTCUSD
DELTA_SYMBOL_GOLD=XAUTUSD

# Claude Analyst (optional). Without a key the Analyst uses rule-based scoring.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANALYST_TIMEOUT_S=30

# ---------------- MetaTrader 5 bridge (Windows only) ----------------
MT5_MODE=demo_only   # demo_only | live   (live still requires the Settings toggle + typed phrase)
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
MT5_SERVER=YourBroker-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_MAGIC=20260101
MT5_DEVIATION=20

# ---------------- Engine ----------------
DEMO_CYCLE_SECONDS=3
PAPER_STARTING_BALANCE=12
API_HOST=127.0.0.1
API_PORT=8765
